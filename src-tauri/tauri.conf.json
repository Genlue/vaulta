{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vaulta",
  "version": "0.3.22",
  "identifier": "com.vaulta.desktop",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "create": false, "title": "vaulta", "width": 1440, "height": 900,
      "minWidth": 900, "minHeight": 570, "center": true,
      "dragDropEnabled": false, "backgroundColor": "#f5f6f8"
    }],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDRkQ2NTA5RDJFMDQ2NEIKUldSTFJ1RFNDV1g5dkhZZEpIS1p5WmNQM0c4OHRXd3gxckZTWXZOVzRDOTlreDlYamlwTHczc0cK",
      "endpoints": ["https://github.com/Genlue/vaulta/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"],
    "shortDescription": "Local-first personal digital asset library",
    "category": "Productivity",
    "windows": {"nsis": {"installMode": "currentUser", "installerIcon": "icons/icon.ico", "languages": ["SimpChinese"]}}
  }
}

